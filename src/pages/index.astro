---
import { getCollection } from 'astro:content';



import ProjectImageOne from '../assets/boltzman_proj.png';
import ProjectImageTwo from '../assets/nbody_proj.png';
import ProjectImageThree from '../assets/marchingcube_proj.png';



import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Léo Bechet</h1>
				<p class="tagline">Computational Physics · Scientific Computing · GPU & Neural Network Systems</p>
				<p>
					I am a physics and computational science researcher currently pursuing a PhD at Uppsala University,
					focused on energy-efficient algorithmic solutions for data-intensive applications. This website
					collects my projects, research notes, and technical blog posts.
				</p>
				<p class="links">
					<a href="https://github.com/lele394">GitHub</a>
					<a href="mailto:lele.bechet@gmail.com">Email</a>
				<a href={`${base}/resume`}>Resume</a>
				<a href={`${base}/blog`}>Blog</a>
				</p>
			</section>

			<section id="about" class="section">
				<h2>Profile</h2>
				<p>
					Passionate about astronomy, optics, and computer science, I hold a Master’s degree in
					Computational Physics and a Bachelor’s degree in Fundamental Physics from the University of
					Bourgogne Franche-Comté.
				</p>
				<p>
					My research background includes projects at FEMTO-ST and the SYSTEM-7 Lab at the University of
					Tokyo, with experience in Python, Fortran, C++/CUDA-style acceleration workflows, OpenMP/OpenACC,
					and neural network training.
				</p>
				<p>
					Languages: French (native), English (C1+), Spanish (A2), Japanese (beginner).
				</p>
			</section>

			<section id="projects" class="section">
				<h2>Projects</h2>
				<div class="project-grid">
					<a
						class="project-tile"
						href="https://www.nebuleo.org/Lattice-Boltzmann-WebGL/"
						target="_blank"
						rel="noreferrer"
						style={`--tile-bg: url(${ProjectImageOne.src});`}
					>
						<h3>D2Q9 Lattice-Boltzmann (WebGL, MRT)</h3>
						<p>
							GPU implementation of a 2D fluid simulation around static objects using WebGL shaders and
							multi-relaxation-time dynamics.
						</p>
					</a>
					<a
						class="project-tile"
						href="https://github.com/lele394/Fortran-N-Body-OpenMP-OpenACC"
						target="_blank"
						rel="noreferrer"
						style={`--tile-bg: url(${ProjectImageTwo.src});`}
					>
						<h3>N-Body Simulation (Fortran + OpenMP/OpenACC)</h3>
						<p>
							GPU/CPU optimized N-body solver with performance comparisons across implementations and
							accuracy/speedup analysis.
						</p>
					</a>
					<a
						class="project-tile"
						href="https://github.com/lele394/CPP-OpenGL-ray-based-renderer/tree/main"
						target="_blank"
						rel="noreferrer"
						style={`--tile-bg: url(${ProjectImageThree.src});`}
					>
						<h3>Marching Cubes in the Browser</h3>
						<p>
							Real-time 3D JavaScript demo with dynamic camera controls and parallel chunk processing for
							efficient visualization of implicit surfaces.
						</p>
					</a>
				</div>
			</section>

			<section class="section">
				<h2>Recent blog posts</h2>
				<ul class="recent-posts">
					{
						recentPosts.map((post) => (
							<li>
								<a class="recent-post-card" href={`${base}/blog/${post.id}/`}>
									<strong>{post.data.title}</strong>
									<p>
										<FormattedDate date={post.data.pubDate} /> · {post.data.description}
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<p><a href={`${base}/blog`}>Browse all posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		gap: 0.7rem;
		border: 1px solid var(--border);
		background: var(--surface);
		padding: 1.2rem;
	}
	.tagline {
		color: var(--muted);
		margin: 0;
	}
	.links {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin: 0;
	}
	.section {
		margin-top: 2rem;
	}
	.project-list,
	.recent-posts {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}
	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}
	.project-tile {
		position: relative;
		overflow: hidden;
		min-height: 230px;
		padding: 1rem;
		border: 1px solid var(--border);
		background: var(--surface);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.45rem;
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease;
		isolation: isolate;
	}
	.project-tile::before {
		content: '';
		position: absolute;
		inset: -10px;
		background-image: var(--tile-bg);
		background-size: cover;
		background-position: center;
		filter: blur(6px) saturate(1.2) brightness(0.85) contrast(1.1);
		transform: scale(1.08);
		z-index: -2;
	}
	.project-tile::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgba(15, 17, 21, 0.82), rgba(15, 17, 21, 0.28)),
			linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(14, 165, 164, 0.03));
		z-index: -1;
	}
	.project-tile:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		text-decoration: none;
	}
	.project-tile h3 {
		margin: 0;
		color: #f8fafc;
	}
	.project-tile p {
		margin: 0;
		color: rgba(248, 250, 252, 0.82);
	}
	.recent-posts li {
		margin: 0;
	}
	.project-tile h3,
	.recent-posts strong {
		margin: 0 0 0.35rem;
	}
	.recent-post-card {
		display: block;
		padding: 0.9rem;
		border: 1px solid var(--border);
		background: var(--surface);
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.recent-post-card:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
		text-decoration: none;
	}
	.recent-post-card strong {
		display: block;
	}
	.recent-posts p {
		margin: 0;
		color: var(--muted);
	}
	@media (max-width: 900px) {
		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.project-grid {
			grid-template-columns: 1fr;
			gap: 0;
			margin: 0;
		}
		.project-tile {
			min-height: 160px;
			padding: 0.8rem;
			border-radius: 0;
			border-left: none;
			border-right: none;
		}
		.project-tile h3 {
			font-size: 0.9rem;
		}
		.project-tile p {
			font-size: 0.85rem;
		}
		.hero {
			padding: 1rem;
			gap: 0.6rem;
			margin: 0;
		}
		.links {
			gap: 0.6rem;
		}
		.section {
			margin-top: 1.2rem;
		}
	}
	@media (max-width: 480px) {
		.project-tile {
			min-height: 140px;
			padding: 0.7rem;
		}
		.project-tile h3 {
			font-size: 0.85rem;
		}
		.project-tile p {
			font-size: 0.8rem;
		}
		.hero {
			padding: 0.8rem;
			gap: 0.5rem;
		}
		.links {
			flex-direction: column;
			gap: 0.4rem;
		}
		.recent-posts {
			gap: 0.5rem;
		}
		.recent-post-card {
			padding: 0.6rem;
		}
	}
</style>
