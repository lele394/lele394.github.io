---
import ProfileImage from '../assets/pfp.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Resume | ${SITE_TITLE}`} description="Fake resume for testing layout and content" />
		<style is:global>
			body.resume-page .resume-hero {
				display: grid;
				grid-template-columns: 140px 1fr;
				gap: 1rem;
				align-items: flex-start;
				border: 1px solid var(--border);
				background: var(--surface);
				padding: 1rem;
			}
			body.resume-page .resume-hero-content {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			body.resume-page .resume-hero-actions {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin-top: 0.5rem;
			}
			body.resume-page .resume-hero-actions a {
				font-size: 0.9rem;
				color: var(--accent);
				border-bottom: 1px solid transparent;
				transition: border-color 120ms ease;
			}
			body.resume-page .resume-hero-actions a:hover {
				border-bottom-color: var(--accent);
			}
			body.resume-page .resume-hero img {
				border: 1px solid var(--border);
				border-radius: 6px;
			}
			body.resume-page .role,
			body.resume-page .meta,
			body.resume-page .muted {
				color: var(--muted);
				margin: 0.2rem 0;
			}
			body.resume-page .resume-section {
				margin-top: 1rem;
				padding: 1rem;
				border: 1px solid var(--border);
				background: var(--surface);
			}
			body.resume-page .item + .item {
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border);
			}
			body.resume-page .two-col {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			body.resume-page ul {
				margin: 0;
				padding-left: 1.1rem;
			}
			@media (max-width: 720px) {
				body.resume-page .resume-hero {
					grid-template-columns: 1fr;
					gap: 0.6rem;
					padding: 1rem;
					margin: 0;
					border-left: none;
					border-right: none;
					border-radius: 0;
				}
				body.resume-page .resume-hero img {
					width: 90px;
					height: 90px;
				}
				body.resume-page .role,
				body.resume-page .meta {
					font-size: 0.8rem;
				}
				body.resume-page .two-col {
					grid-template-columns: 1fr;
				}
				body.resume-page .resume-section {
					padding: 1rem;
					margin: 0;
					margin-top: 0;
					border-left: none;
					border-right: none;
					border-radius: 0;
				}
			}
			@media (max-width: 480px) {
				body.resume-page main {
					padding: 0;
				}
				body.resume-page .resume-hero {
					padding: 0.8rem;
					gap: 0.5rem;
				}
				body.resume-page .resume-hero img {
					width: 75px;
					height: 75px;
				}
				body.resume-page h1 {
					font-size: 1.15rem;
				}
				body.resume-page .role,
				body.resume-page .meta {
					font-size: 0.75rem;
				}
				body.resume-page .resume-hero-actions a {
					font-size: 0.8rem;
				}
				body.resume-page .resume-section {
					padding: 0.8rem;
				}
			}
		</style>
	</head>
	<body class="resume-page">
		<Header />
		<main>
			<section class="resume-hero">
				<img src={ProfileImage.src} alt="Profile placeholder" width="140" height="140" />
				<div class="resume-hero-content">
					<div>
						<h1>Léo Bechet</h1>
						<p class="role">PhD Student · Scientific Computing · Computational Physics</p>
						<p class="meta">Uppsala, Sweden · +33 7 81 25 10 39 · lele.bechet@gmail.com · github.com/lele394</p>
					</div>
					<div class="resume-hero-actions">
						<a href="https://github.com/lele394/lele394/blob/main/Resume_but_mine.pdf" download>↓ Download PDF resume</a> <i style="font-size:0.8rem" >(I suck at keeping stuff up to date, feel free to contact me)</i>
					</div>
				</div>
			</section>

			<section class="resume-section">
				<h2>Summary</h2>
				<p>
					Passionate about astronomy, optics, and computer science, I have research experience in
					computational physics, machine learning, and scientific programming. I am currently pursuing a PhD
					at Uppsala University on energy-efficient algorithmic solutions for data-intensive applications.
					I enjoy building performant numerical tools and bridging theory with practical engineering.
				</p>
			</section>

			<section class="resume-section">
				<h4>Notes and disclaimer</h4>
				<p class="muted">
					Former UBFC academic programs (Université Bourgogne-Franche-Comté, COMUE) are now part of the <a href="https://www.umlp.fr/">Université Marie et Louis Pasteur (UMLP)</a> following the 2025 institutional restructuring.
				</p>
			</section>


			<section class="resume-section">
				<h2>Positions</h2>
				<div class="item">
					<h3>PhD Representative · UPPMAX, Uppsala University</h3>
					<p class="muted">June 2026 — Ongoing · <i>Uppsala University, Sweden</i></p>
					<p>
						PhD representative at the <a href="https://docs.uppmax.uu.se/cluster_guides/uppmax_as_an_organisation/">Uppsala Multidisciplinary Center for Advanced Computational Science (UPPMAX)</a>, on behalf of the <a href="https://www.tndr.se/">Teknisk-Naturvetenskapliga DoktorandRådet (TNDR)</a>.
						<!-- Empty -->
					</p>
				</div>
			</section>

			<section class="resume-section">
				<h2>Education</h2>
				<div class="item">
					<h3>PhD · Data-Intensive Scientific Computing</h3>
					<p class="muted">Sep 2025 — Ongoing · <i>Uppsala University, Sweden</i></p>
					<p>
						Energy-efficient algorithmic solutions for data-intensive applications.
					</p>
				</div>
				<div class="item">
					<h3>Master's in Physics & Computational Physics (<a href="https://gradschool.eiphi.ubfc.fr/?page_id=3275">CompuPhys</a>)</h3>
					<p class="muted">Sep 2023 — Jul 2025 · <i>University of Bourgogne Franche-Comté, France </i></p>
					<p>
						Master 1 completed in 2024, Master 2 completed in 2025. Covered spectroscopy, quantum physics, laser physics, numerical methods, machine learning, and high-performance computing.
					</p>
				</div>
				<div class="item">
					<h3>Bachelor's in Fundamental Physics</h3>
					<p class="muted">Jul 2021 — Jun 2023 · <i>University of Bourgogne Franche-Comté, France </i></p>
					<p>
						Completed in 2023. Covered classical mechanics, electromagnetism, quantum mechanics, thermodynamics, laser physics and fluid dynamics.
				</div>

				<div class="item">
					<h3>Preparatory Classes for Engineering</h3>
					<p class="muted">Jul 2019 — Jun 2021 · <i>University of Bourgogne Franche-Comté, France</i></p>
					<p>
						Completed in 2021. Specialization in Physics & Chemistry. Also covered mechanical engineering and mathematics.
				</div>
			</section>

			<section class="resume-section">
				<h2>Research Internships</h2>

				<div class="item">
					<h3><a href="https://nextgentriggers.web.cern.ch/cern-steam-academy/">STEAM Academy</a>, CERN</h3>
					<p class="muted">Jun 2026 — Aug 2026</p>
					<p>
						A 10-weeks long summer school at CERN combining Software Technologies, Edge computing, Analytics and Machine learning. A curriculum for future Data acquisition, Edge computing, Advanced software and Data science experts.
					</p>
				</div>

				<div class="item">
					<h3>System-7 Lab, University of Tokyo</h3>
					<p class="muted">Feb 2025 — Jul 2025 · Supervised by  <a href="https://scholar.google.com/citations?user=6V3Ip-4AAAAJ">André RÖHM</a>   & <a href="https://scholar.google.com/citations?hl=en&user=Ubba3VMAAAAJ">Ryoichi HORISAKI</a></p>
					<p>
						Hybrid gradient propagation via DFA-seeding for efficient parallel training of physical neural
						networks (Project still ongoing).
					</p>
				</div>
				<div class="item">
					<h3>FEMTO-ST (Time & Frequency Department)</h3>
					<p class="muted">Jun 2024 — Aug 2024 · Supervised by <a href="https://scholar.google.com/citations?hl=en&user=pGtPmWEAAAAJ">Marion DELEHAYE</a></p>
					<p>
						Stepper-motor-based laser sweeping system and PWM control design for cleaning ytterbium deposits
						in optical setups.
					</p>
				</div>
				<div class="item">
					<h3>UBFC  Computational Physics Projects</h3>
					<p class="muted">2023 — 2024 · Supervised by <a href="https://www.linkedin.com/in/barnab%C3%A9-d%C3%A9for%C3%AAt-b6b424349/">Barnabé Deforet</a></p>
					<p>
						3D Milky Way extinction mapping with neural networks, potential energy surface modeling in
						Fortran, and relativistic black-hole simulation/game engine in Python.
					</p>
				</div>
			</section>

			<section class="resume-section two-col">
				<div>
					<h2>Skills</h2>
					<ul>
						<li><strong>Programming:</strong> Fortran, Python, C, C#, JavaScript, Bash, GLSL/HLSL, FPGA(?)</li>
						<li><strong>HPC:</strong> Likwid, OpenMP, MPI, OpenACC, GPU acceleration, numerical simulation</li>
						<li><strong>ML:</strong> TensorFlow, PyTorch, scientific model training workflows</li>
						<li><strong>Tools:</strong> Docker, Portainer, LaTeX, Jupyter, Markdown</li>
					</ul>
				</div>
				<div>
					<h2>Languages & Extras</h2>
					<ul>
						<li>English (C1+), French (native), Spanish (A2), Japanese (beginner)</li>
						<li>Photography and astrophotography, image processing</li>
						<li>Electronics, embedded systems, optical test-bench experience</li>
						<li>Course-En-Cours 2017 <a href="https://www.macommune.info/courses-en-cours-monter-une-ecurie-mode-demploi-161448/">regional winner</a> ( (Ze-Mete-Or) team engineering project)</li>
					</ul>
				</div>
			</section>

			<section class="resume-section">
				<h2>Projects</h2>
				<p> <i>Non exhaustive list, please refer to my <a href="https://github.com/lele394?tab=repositories">GitHub Profile</a>.  </i> </p>
				<div class="item">
					<h3>D2Q9 Lattice-Boltzmann Simulation (WebGL, MRT)</h3>
					<p class="muted">Feb 2026 — Ongoing · Personal project</p>
					<p>
						Implemented a D2Q9 Lattice-Boltzmann fluid simulation with multi-relaxation-time dynamics using
						WebGL shaders. The solver handles 2D flow around static obstacles and reproduces known physical
						phenomena. <a href="https://github.com/lele394/Lattice-Boltzmann-WebGL" target="_blank" rel="noreferrer">Source repo</a> | <a href="https://www.nebuleo.org/Lattice-Boltzmann-WebGL/" target="_blank" rel="noreferrer">Live demo</a>.
					</p>
				</div>
				<div class="item">
					<h3>GPU/CPU Optimized N-Body Simulation in Fortran</h3>
					<p class="muted">Oct 2024 — Dec 2024 · University of Bourgogne Franche-Comté</p>
					<p>
						Built an N-body simulation and optimized it for high performance with OpenMP and OpenACC.
						Compared implementation speedups and numerical accuracy across CPU/GPU variants. <a href="https://github.com/lele394/Fortran-N-Body-OpenMP-OpenACC" target="_blank" rel="noreferrer">Source repo</a>.
					</p>
				</div>
				<div class="item">
					<h3>Stability and Evolution of Conway's Game of Life</h3>
					<p class="muted">Jan 2024 — Jul 2024 · University of Bourgogne Franche-Comté</p>
					<p>
						Studied cellular automaton stability with hardware-accelerated computation, including filling
						percentage analysis and Lyapunov exponent exploration under multiple Tychonov distance
						definitions.
					</p>
				</div>
				<div class="item">
					<h3>Strange Attractor Visualizer</h3>
					<p class="muted">Mar 2024 — Ongoing · Personal project</p>
					<p>
						Developed a Python/Matplotlib tool for 2D and 3D strange attractor visualization, with a library
						of well-known systems and support for custom definitions.
					</p>
				</div>
				<div class="item">
					<h3>Web Implementation of the Marching Cubes Algorithm</h3>
					<p class="muted">Feb 2024 · Personal project</p>
					<p>
						Created a real-time JavaScript 3D demo with dynamic camera controls and optimized chunk
						management. Implemented Mandelbulb marching cubes with Web Workers for parallelization.
					</p>
				</div>
				<div class="item">
					<h3>Web-Based 3D Raycast Renderer Development</h3>
					<p class="muted">Feb 2024 · Personal project</p>
					<p>
						Implemented GPU-accelerated ray marching for voxel data in the browser and focused on real-time
						shader optimization for interactive web graphics.
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
