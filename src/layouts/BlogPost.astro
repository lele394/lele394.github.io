---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: var(--layout-max-width);
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 1rem;
			}
			.hero-image img {
				border: 1px solid var(--border);
				border-radius: 4px;
			}
			.hero-image img,
			.image-card img {
				cursor: zoom-in;
			}
			.prose {
				width: 100%;
				max-width: 100%;
				margin: auto;
				padding: 0;
				color: var(--text);
			}
			.title {
				margin-bottom: 1rem;
				padding-bottom: 0.8rem;
				line-height: 1.3;
				border-bottom: 1px solid var(--border);
			}
			.title h1 {
				margin: 0.2rem 0;
			}
			.date {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
				color: var(--muted);
				font-size: 0.9rem;
			}
			.tags {
				display: flex;
				gap: 0.35rem;
				flex-wrap: wrap;
			}
			.tag {
				color: var(--accent);
				border: 1px solid var(--border);
				padding: 0.1rem 0.45rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.back-to-posts {
				display: inline-block;
				margin-top: 1.5rem;
				padding-top: 0.8rem;
				border-top: 1px solid var(--border);
			}
			.image-lightbox {
				padding: 0;
				border: 0;
				background: transparent;
				max-width: none;
				max-height: none;
			}
			.image-lightbox::backdrop {
				background: rgba(11, 18, 32, 0.82);
				backdrop-filter: blur(3px);
			}
			.image-lightbox__panel {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				width: min(96vw, 1280px);
				height: min(96vh, 920px);
			}
			.image-lightbox__button {
				position: absolute;
				top: 0.75rem;
				right: 0.75rem;
				z-index: 1;
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 999px;
				background: rgba(11, 18, 32, 0.75);
				color: #fff;
				padding: 0.45rem 0.8rem;
				cursor: pointer;
			}
			.image-lightbox__button:hover {
				border-bottom-color: rgba(255, 255, 255, 0.2);
			}
			.image-lightbox__img {
				max-width: 100%;
				max-height: 100%;
				width: auto;
				height: auto;
				object-fit: contain;
				border-radius: 8px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
			}
			@media (max-width: 720px) {
				.image-lightbox__panel {
					padding: 0.65rem;
					width: 100vw;
					height: 100vh;
				}
				.image-lightbox__img {
					max-width: calc(100vw - 1.4rem);
					max-height: calc(100vh - 4rem);
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{
							tags.length > 0 && (
								<div class="tags">
									{tags.map((tag) => <a class="tag" href={`${base}/blog?tag=${tag.toLowerCase()}`}>#{tag}</a>)}
								</div>
							)
						}
						<h1>{title}</h1>
					</div>
					<slot />
					<a class="back-to-posts" href={`${base}/blog`}>← Return to all posts</a>
				</div>
			</article>
		</main>
		<dialog class="image-lightbox" aria-label="Image preview">
			<div class="image-lightbox__panel">
				<form method="dialog">
					<button class="image-lightbox__button" aria-label="Close preview">Close</button>
				</form>
				<img class="image-lightbox__img" alt="" />
			</div>
		</dialog>
		<script is:inline>
			const dialog = document.querySelector('.image-lightbox');
			const dialogImage = dialog?.querySelector('.image-lightbox__img');
			const zoomableImages = document.querySelectorAll('.hero-image img, .image-card img');

			if (dialog && dialogImage) {
				const openPreview = (img) => {
					dialogImage.src = img.currentSrc || img.src;
					dialogImage.alt = img.alt || 'Preview image';
					dialog.showModal();
				};

				zoomableImages.forEach((img) => {
					img.addEventListener('click', () => openPreview(img));
				});

				dialog.addEventListener('click', (event) => {
					const rect = dialog.getBoundingClientRect();
					const clickedBackdrop =
						event.clientX < rect.left ||
						event.clientX > rect.right ||
						event.clientY < rect.top ||
						event.clientY > rect.bottom;

					if (clickedBackdrop) {
						dialog.close();
					}
				});

				dialog.addEventListener('close', () => {
					dialogImage.removeAttribute('src');
					dialogImage.alt = '';
				});
			}
		</script>
		<Footer />
	</body>
</html>
